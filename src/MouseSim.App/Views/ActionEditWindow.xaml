<Window x:Class="MouseSim.App.Views.ActionEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:MouseSim.App.Infrastructure"
        Title="编辑动作" Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="{StaticResource WindowBackBrush}">
    <StackPanel Margin="18,14,18,16">

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource FieldLabel}" Text="动作类型" Width="80" />
            <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}"
                      DisplayMemberPath="Label" Width="220" />
        </StackPanel>

        <!-- 鼠标点击 -->
        <StackPanel Visibility="{Binding ShowClick, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Style="{StaticResource FieldLabel}" Text="位置" Width="80" />
                <RadioButton Content="当前位置（不移动）" IsChecked="{Binding UseCurrentPosition}" />
                <RadioButton Content="指定坐标" IsChecked="{Binding UseCurrentPosition, Converter={StaticResource InverseBool}}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" IsEnabled="{Binding UseCoordinates}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="坐标" Width="80" />
                <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" Width="86" />
                <TextBlock Text="Y" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Width="86" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="鼠标键" Width="80" />
                <ComboBox ItemsSource="{Binding ButtonOptions}" SelectedItem="{Binding Button}"
                          DisplayMemberPath="Label" Width="120" Margin="0,0,18,0" />
                <CheckBox Content="双击" IsChecked="{Binding DoubleClick}" />
            </StackPanel>
        </StackPanel>

        <!-- 鼠标移动 -->
        <StackPanel Visibility="{Binding ShowMove, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="目标坐标" Width="80" />
                <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" Width="86" />
                <TextBlock Text="Y" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Width="86" />
            </StackPanel>
        </StackPanel>

        <!-- 鼠标拖拽 -->
        <StackPanel Visibility="{Binding ShowDrag, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Style="{StaticResource FieldLabel}" Text="起点" Width="80" />
                <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox Text="{Binding FromX, UpdateSourceTrigger=PropertyChanged}" Width="86" />
                <TextBlock Text="Y" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox Text="{Binding FromY, UpdateSourceTrigger=PropertyChanged}" Width="86" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Style="{StaticResource FieldLabel}" Text="终点" Width="80" />
                <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox Text="{Binding ToX, UpdateSourceTrigger=PropertyChanged}" Width="86" />
                <TextBlock Text="Y" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox Text="{Binding ToY, UpdateSourceTrigger=PropertyChanged}" Width="86" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="鼠标键" Width="80" />
                <ComboBox ItemsSource="{Binding ButtonOptions}" SelectedItem="{Binding Button}"
                          DisplayMemberPath="Label" Width="120" Margin="0,0,18,0" />
                <TextBlock Text="时长" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox Text="{Binding DragDuration, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                <TextBlock Text="毫秒" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- 滚轮 -->
        <StackPanel Visibility="{Binding ShowScroll, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Style="{StaticResource FieldLabel}" Text="方向" Width="80" />
                <RadioButton Content="垂直（上 / 下）" IsChecked="{Binding ScrollHorizontal, Converter={StaticResource InverseBool}}" />
                <RadioButton Content="水平（左 / 右）" IsChecked="{Binding ScrollHorizontal}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="格数" Width="80" />
                <TextBox Text="{Binding ScrollDelta, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                <TextBlock Text="正数向上 / 向左，负数向下 / 向右，一格约三行" Margin="10,0,0,0"
                           Style="{StaticResource HintText}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- 按键 / 组合键 -->
        <StackPanel Visibility="{Binding ShowKeyPress, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Style="{StaticResource FieldLabel}" Text="修饰键" Width="80" />
                <CheckBox Content="Ctrl" IsChecked="{Binding HasCtrl}" Margin="0,0,12,0" />
                <CheckBox Content="Alt" IsChecked="{Binding HasAlt}" Margin="0,0,12,0" />
                <CheckBox Content="Shift" IsChecked="{Binding HasShift}" Margin="0,0,12,0" />
                <CheckBox Content="Win" IsChecked="{Binding HasWin}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="按键" Width="80" />
                <ComboBox ItemsSource="{x:Static infra:WpfKeys.SelectableKeys}" SelectedItem="{Binding PressKey}"
                          Width="160">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource KeyDisplay}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <!-- 按住按键 -->
        <StackPanel Visibility="{Binding ShowKeyHold, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Style="{StaticResource FieldLabel}" Text="按键" Width="80" />
                <ComboBox ItemsSource="{x:Static infra:WpfKeys.SelectableKeys}" SelectedItem="{Binding HoldKey}"
                          Width="160">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource KeyDisplay}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="按住时长" Width="80" />
                <TextBox Text="{Binding HoldDuration, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                <TextBlock Text="毫秒" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- 输入文本 -->
        <StackPanel Visibility="{Binding ShowText, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="文本内容" Width="80" Margin="0,0,0,6" />
            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                      Height="110" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="6" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                       Text="以 Unicode 方式输入，支持中文；换行会按回车键发送。请确保目标位置已处于可输入状态。" />
        </StackPanel>

        <!-- 等待 -->
        <StackPanel Visibility="{Binding ShowDelay, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="等待时长" Width="80" />
                <TextBox Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                <TextBlock Text="毫秒" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" Margin="0,12,0,0"
                   TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="确定" IsDefault="True" Click="Ok_Click" MinWidth="84" />
            <Button Style="{StaticResource ToolButton}" Content="取消" IsCancel="True" Margin="10,0,0,0" MinWidth="70" />
        </StackPanel>
    </StackPanel>
</Window>
