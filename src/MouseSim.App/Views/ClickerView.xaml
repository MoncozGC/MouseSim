<UserControl x:Class="MouseSim.App.Views.ClickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,2" MaxWidth="560" HorizontalAlignment="Left">

            <GroupBox Header="运行">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding StartButtonText}" MinWidth="130"
                            Command="{Binding StartCommand}" />
                    <Button Style="{StaticResource DangerButton}" Content="{Binding StopButtonText}" MinWidth="130"
                            Command="{Binding StopCommand}" Margin="12,0,0,0" />
                    <TextBlock VerticalAlignment="Center" Margin="18,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="已点击 " />
                        <Run Text="{Binding ClickCount, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" 次" />
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="点击参数">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="点击间隔" Width="66" />
                        <TextBox Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                        <TextBlock Text="毫秒（最少 10，约等于每秒 1000/间隔 次）" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Style="{StaticResource HintText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="鼠标键" Width="66" />
                        <ComboBox ItemsSource="{Binding ButtonOptions}" SelectedItem="{Binding SelectedButton}"
                                  DisplayMemberPath="Label" Width="120" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="点击方式" Width="66" />
                        <RadioButton Content="单击" IsChecked="{Binding DoubleClick, Converter={StaticResource InverseBool}}" />
                        <RadioButton Content="双击" IsChecked="{Binding DoubleClick}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="点击位置">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="位置" Width="66" />
                        <RadioButton Content="跟随鼠标当前位置" IsChecked="{Binding UseFixed, Converter={StaticResource InverseBool}}" />
                        <RadioButton Content="固定坐标" IsChecked="{Binding UseFixed}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="坐标" Width="66" />
                        <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding XText, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                 IsEnabled="{Binding UseFixed}" />
                        <TextBlock Text="Y" VerticalAlignment="Center" Margin="12,0,6,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding YText, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                 IsEnabled="{Binding UseFixed}" />
                        <Button Style="{StaticResource ToolButton}" Command="{Binding PickCommand}"
                                Content="{Binding PickButtonText}" Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource HintText}" Margin="66,8,0,0"
                               Text="点击「拾取坐标」后有 5 秒时间，把鼠标移到目标位置即可自动捕获；负数坐标用于多显示器（如副屏在主屏左侧）。" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="次数">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="次数" Width="66" />
                    <CheckBox Content="无限点击，直到按停止" IsChecked="{Binding Infinite}" />
                    <TextBox Text="{Binding RepeatText, UpdateSourceTrigger=PropertyChanged}" Width="80"
                             Margin="12,0,0,0" IsEnabled="{Binding Infinite, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
