<Window x:Class="MouseSim.App.Views.FloatingStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        Width="230" Height="60" WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI">
    <!-- 整卡可点击 = 停止当前录制/任务（悬停变亮提示）；窗口保持 NOACTIVATE，点击不抢前台程序焦点 -->
    <Border x:Name="Card" CornerRadius="16" Padding="18,0,18,0" Cursor="Hand"
            MouseLeftButtonUp="Card_MouseLeftButtonUp">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#E8252525" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F03B3B3B" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="Dot" Width="13" Height="13" Fill="#FF5B5B" VerticalAlignment="Center">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.25" Duration="0:0:0.9" AutoReverse="True"
                                                 RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Foreground="White" FontWeight="SemiBold" FontSize="14"
                           Text="正在运行" />
                <TextBlock x:Name="DetailText" Foreground="#C9CDD4" FontSize="11.5" Margin="0,3,0,0"
                           Text="" TextTrimming="CharacterEllipsis" MaxWidth="160" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
