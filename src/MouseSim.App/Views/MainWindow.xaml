<Window x:Class="MouseSim.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:MouseSim.App.Views"
        Title="MouseSim — 鼠标键盘模拟器"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="660" Width="980" MinHeight="580" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="{StaticResource WindowBackBrush}">
    <DockPanel>
        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="#FAFBFC" BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,1,0,0" Padding="14,7">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" Margin="16,0,0,0"
                           Text="{Binding Status.HotkeyHint, StringFormat=快捷键：{0}}" />
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontWeight="SemiBold" Margin="16,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="○ 待机" />
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status.IsRecording}" Value="True">
                                    <Setter Property="Text" Value="● 录制中" />
                                    <Setter Property="Foreground" Value="#D98A15" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status.IsRunning}" Value="True">
                                    <Setter Property="Text" Value="● 运行中" />
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Status.Text}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" />
            </DockPanel>
        </Border>

        <TabControl TabStripPlacement="Left" SelectedIndex="{Binding ActiveTab}" Margin="12,10,12,10">
            <TabItem Header="录制">
                <v:RecorderView DataContext="{Binding Recorder}" />
            </TabItem>
            <TabItem Header="重复">
                <v:ScriptView DataContext="{Binding Scripts}" />
            </TabItem>
            <TabItem Header="连点器">
                <v:ClickerView DataContext="{Binding Clicker}" />
            </TabItem>
            <TabItem Header="设置">
                <v:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
