<UserControl x:Class="MouseSim.App.Views.RecorderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 录制控制 -->
        <GroupBox Grid.Row="0" Header="录制" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding StartRecordCommand}" Content="{Binding StartRecordButtonText}" MinWidth="170">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding StopRecordCommand}" Content="{Binding StopRecordButtonText}" MinWidth="170">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding LiveText}" VerticalAlignment="Center" Margin="16,0,0,0"
                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="用法：点「开始录制」（或按 F9）→ 到目标程序里正常操作 → 点「停止录制」（或再按 F9）。对 MouseSim 自身窗口的点击不会被记录；录制期间按 F6/F8/F9 热键也不会被录进去。动作之间的真实停顿会记录为等待（60 毫秒以下忽略，超过 1 分钟截断）。" />
            </StackPanel>
        </GroupBox>

        <!-- 录制结果：操作按钮固定在上方，动作列表在剩余空间内滚动 -->
        <GroupBox Grid.Row="1" Header="录制结果">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}" Content="保存并立即运行（F8 停止）"
                                Command="{Binding SaveAndRunCommand}" />
                        <Button Style="{StaticResource ToolButton}" Content="保存为脚本"
                                Command="{Binding SaveCommand}" Margin="10,0,0,0" />
                        <Button Style="{StaticResource ToolButton}" Content="丢弃" Command="{Binding DiscardCommand}"
                                Margin="10,0,0,0" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                               Text="保存后可在「重复」页编辑细节、设置循环/重复时长或勾选后批量运行。" />
                </StackPanel>
                <ListBox ItemsSource="{Binding ResultActions}" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Index}" Width="26" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <Border Background="{StaticResource AccentLightBrush}" CornerRadius="4"
                                        Padding="7,2" MinWidth="38" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource AccentBrush}"
                                               FontSize="11.5" />
                                </Border>
                                <TextBlock Text="{Binding Description}" Margin="10,0,8,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>
    </Grid>
</UserControl>
