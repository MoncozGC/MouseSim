<UserControl x:Class="MouseSim.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:MouseSim.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,2" MaxWidth="560" HorizontalAlignment="Left">

            <GroupBox Header="全局热键">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="开始" Width="96" />
                        <v:HotkeyCaptureBox Hotkey="{Binding StartHotkey}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="停止" Width="96" />
                        <v:HotkeyCaptureBox Hotkey="{Binding StopHotkey}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="开始/停止录制" Width="96" />
                        <v:HotkeyCaptureBox Hotkey="{Binding RecordHotkey}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="三个热键的作用：&#x0a;· 开始 —— 启动「当前停留页面」的任务：「重复」页运行选中的脚本，「连点器」页开始点击；在「录制」「设置」页按下会提示先切换页面。&#x0a;· 停止 —— 立即停止一切正在运行的任务。&#x0a;· 录制 —— 开始或结束录制。&#x0a;热键在任何程序中都全局生效（按键会被本程序优先接收）。点击右侧输入框后直接按下想要的组合键即可录制，建议使用 Ctrl/Alt/Shift + 任意键的组合；纯单键（尤其是字母数字键）会被全局占用，影响正常打字。" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="保存" Command="{Binding SaveCommand}" />
                        <Button Style="{StaticResource ToolButton}" Content="恢复默认（F6 / F8 / F9）" Command="{Binding ResetCommand}"
                                Margin="10,0,0,0" />
                        <TextBlock Text="{Binding SavedText}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="数据位置">
                <StackPanel>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="脚本与设置保存在以下目录，可直接备份或拷贝到另一台电脑：" />
                    <TextBlock Text="{Binding DataFolder}" Margin="0,6,0,0" FontFamily="Consolas" FontSize="12"
                               TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="关于">
                <StackPanel>
                    <TextBlock Text="MouseSim 鼠标键盘模拟器" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                               Text="{Binding AppVersion, StringFormat=版本 {0}　·　.NET 8 / WPF}" />
                    <TextBlock Margin="0,10,0,0">
                        <Hyperlink NavigateUri="https://github.com/MoncozGC/MouseSim"
                                   RequestNavigate="OpenLink">https://github.com/MoncozGC/MouseSim</Hyperlink>
                    </TextBlock>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="录制、重复、批量执行鼠标键盘操作，面向办公自动化与批量重复操作。遇到问题或建议欢迎提 Issue。" />
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
